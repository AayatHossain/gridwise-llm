# Copy to .env (git-ignored) or set these in your hosting platform. Names only - never commit real values.

# --- language model (mandatory for operator-note interpretation) ---
LLM_PROVIDER=openai            # openai | anthropic | none (none = every note becomes no_op; offline tests only)
LLM_MODEL=gpt-4.1              # gpt-4.1-mini is ~5x cheaper and also passed every public/paraphrase check
OPENAI_API_KEY=                # required for LLM_PROVIDER=openai (LLM_API_KEY is accepted as an alias)
# LLM_BASE_URL=                # optional OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1
# LLM_FALLBACK_MODEL=          # optional second model tried if the primary call fails
# ANTHROPIC_API_KEY=           # only for LLM_PROVIDER=anthropic
# LLM_EFFORT=low               # anthropic only: low | medium | high | none

# --- timing (judge timeout is 30 s per request) ---
LLM_TIMEOUT_SECONDS=20         # one model call
LLM_TOTAL_BUDGET_SECONDS=22    # all interpretation attempts for one request
LLM_CACHE_SIZE=512             # cached interpretations (0 disables)

# --- service ---
PORT=8000
LOG_LEVEL=INFO
